{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://8dionysus.github.io/aoa-memo/schemas/memory-ports/local_memo_export.schema.json",
  "title": "AoA local memo export",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "repo",
    "target_owner",
    "target_route",
    "candidate_refs",
    "receipt_refs",
    "source_refs",
    "evidence_refs",
    "allowed_result",
    "created_at"
  ],
  "properties": {
    "schema": {
      "const": "aoa_local_memo_export_v1"
    },
    "id": {
      "type": "string",
      "pattern": "^export:[^:]+:[0-9]{8}T[0-9]{6}Z:[a-z0-9][a-z0-9-]*$"
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "target_owner": {
      "const": "aoa-memo"
    },
    "target_route": {
      "const": "reviewed_intake"
    },
    "candidate_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "receipt_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_result": {
      "enum": [
        "candidate_only",
        "reviewed_write",
        "quarantine",
        "archive_only",
        "reject"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  }
}

