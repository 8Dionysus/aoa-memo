{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://8dionysus.github.io/aoa-memo/schemas/memory-ports/local_memo_receipt.schema.json",
  "title": "AoA local memo receipt",
  "oneOf": [
    {
      "title": "AoA local memo receipt v1 legacy",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "id",
        "repo",
        "candidate_ref",
        "result",
        "route",
        "checks",
        "errors",
        "created_at"
      ],
      "properties": {
        "schema": {
          "const": "aoa_local_memo_receipt_v1"
        },
        "id": {
          "type": "string",
          "pattern": "^receipt:[^:]+:[0-9]{8}T[0-9]{6}Z:[a-z0-9][a-z0-9-]*$"
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "candidate_ref": {
          "type": "string",
          "minLength": 1
        },
        "export_ref": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "validated",
            "rejected",
            "forwarded",
            "reviewed",
            "landed",
            "archived"
          ]
        },
        "route": {
          "type": "string",
          "minLength": 1
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "reviewed_by": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    {
      "title": "AoA local memo receipt v2",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "id",
        "repo",
        "candidate_ref",
        "result",
        "route",
        "checks",
        "errors",
        "created_at"
      ],
      "properties": {
        "schema": {
          "const": "aoa_local_memo_receipt_v2"
        },
        "id": {
          "type": "string",
          "pattern": "^receipt:[^:]+:[0-9]{8}T[0-9]{6}Z:[a-z0-9][a-z0-9-]*$"
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "candidate_ref": {
          "type": "string",
          "minLength": 1
        },
        "export_ref": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "validated",
            "rejected",
            "forwarded",
            "landed",
            "archived"
          ]
        },
        "route": {
          "type": "string",
          "minLength": 1
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "checked_by": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    }
  ]
}
