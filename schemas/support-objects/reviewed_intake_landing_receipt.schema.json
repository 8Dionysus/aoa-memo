{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/8Dionysus/aoa-memo/main/schemas/support-objects/reviewed_intake_landing_receipt.schema.json",
  "title": "aoa-memo reviewed intake landing receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "repo",
    "source_export_ref",
    "copied_intake_ref",
    "candidate_refs",
    "object_ref",
    "object_path",
    "result",
    "checks",
    "errors",
    "landed_at",
    "landed_by"
  ],
  "properties": {
    "schema": {
      "const": "aoa_memo_reviewed_intake_landing_receipt_v1"
    },
    "id": {
      "type": "string",
      "pattern": "^landing-receipt:[^:]+:[0-9]{8}T[0-9]{6}Z:[a-z0-9][a-z0-9-]*$"
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "source_export_ref": {
      "type": "string",
      "minLength": 1
    },
    "copied_intake_ref": {
      "type": "string",
      "minLength": 1
    },
    "candidate_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "receipt_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "object_ref": {
      "type": "string",
      "minLength": 1
    },
    "object_path": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "enum": [
        "landed",
        "quarantined",
        "rejected"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "landed_at": {
      "type": "string",
      "format": "date-time"
    },
    "landed_by": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    }
  }
}
