{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/8Dionysus/aoa-memo/main/schemas/support-objects/active_organ_memo_contracts_v1.schema.json",
  "title": "aoa-memo active-organ owner contracts v1",
  "description": "Strict memo-owned contracts for evidence, reviewed memory, bounded recall, lifecycle, and distributed erasure. These contracts carry memory evidence and policy posture; they never grant routing or effect authority.",
  "oneOf": [
    {
      "$ref": "#/$defs/memory_evidence_envelope"
    },
    {
      "$ref": "#/$defs/memory_candidate_packet"
    },
    {
      "$ref": "#/$defs/memory_quarantine_packet"
    },
    {
      "$ref": "#/$defs/reviewed_memory_object"
    },
    {
      "$ref": "#/$defs/provenance_thread"
    },
    {
      "$ref": "#/$defs/memory_lifecycle_transition"
    },
    {
      "$ref": "#/$defs/recall_packet"
    },
    {
      "$ref": "#/$defs/intervention_decision"
    },
    {
      "$ref": "#/$defs/memory_influence_policy_envelope"
    },
    {
      "$ref": "#/$defs/memory_projection_manifest"
    },
    {
      "$ref": "#/$defs/memory_erase_request"
    },
    {
      "$ref": "#/$defs/distributed_memory_erase_manifest"
    },
    {
      "$ref": "#/$defs/per_owner_erase_work_item"
    },
    {
      "$ref": "#/$defs/erase_completion_or_residue_receipt"
    }
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1024
    },
    "ref_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      },
      "uniqueItems": true
    },
    "non_empty_ref_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ref"
      },
      "uniqueItems": true
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "owner_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
    },
    "source_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ref",
        "source_owner",
        "source_version",
        "content_digest"
      ],
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/ref"
        },
        "source_owner": {
          "$ref": "#/$defs/owner_id"
        },
        "source_version": {
          "$ref": "#/$defs/non_empty_string"
        },
        "content_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "generation_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generator_id",
        "generator_version",
        "generated_at"
      ],
      "properties": {
        "generator_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "generator_version": {
          "$ref": "#/$defs/non_empty_string"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "policy_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_version",
        "decision_ref"
      ],
      "properties": {
        "policy_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "policy_version": {
          "$ref": "#/$defs/non_empty_string"
        },
        "decision_ref": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "freshness_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_at",
        "freshness_class"
      ],
      "properties": {
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "freshness_class": {
          "enum": [
            "current",
            "stale",
            "unknown"
          ]
        }
      }
    },
    "taint_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tainted",
        "labels",
        "policy_version",
        "sanitizer_receipt_ref",
        "quarantine_required"
      ],
      "properties": {
        "tainted": {
          "type": "boolean"
        },
        "labels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        },
        "policy_version": {
          "$ref": "#/$defs/non_empty_string"
        },
        "sanitizer_receipt_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 3
        },
        "quarantine_required": {
          "type": "boolean"
        }
      }
    },
    "trust_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_kind",
        "confidence"
      ],
      "properties": {
        "authority_kind": {
          "enum": [
            "operator",
            "owner_source",
            "direct_observation",
            "agent_derived",
            "unknown"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "proposed_belief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "confidence"
      ],
      "properties": {
        "statement": {
          "$ref": "#/$defs/non_empty_string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "proposed_applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scopes",
        "conditions"
      ],
      "properties": {
        "scopes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "thread",
              "session",
              "user",
              "agent",
              "project",
              "workspace",
              "ecosystem",
              "tos_lineage"
            ]
          },
          "uniqueItems": true
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        }
      }
    },
    "common_header": {
      "type": "object",
      "required": [
        "contract_type",
        "schema_version",
        "contract_id",
        "contract_name",
        "instance_id",
        "object_version",
        "idempotency_key",
        "produced_at",
        "owner",
        "validation_status",
        "source_refs",
        "generation_pin",
        "policy_pin",
        "content_digest"
      ],
      "properties": {
        "contract_type": {
          "$ref": "#/$defs/non_empty_string"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "contract_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "contract_name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "instance_id": {
          "$ref": "#/$defs/ref"
        },
        "object_version": {
          "type": "integer",
          "minimum": 1
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,255}$"
        },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        },
        "owner": {
          "const": "aoa-memo"
        },
        "validation_status": {
          "enum": [
            "valid",
            "partial",
            "failed",
            "invalid"
          ]
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source_pin"
          },
          "uniqueItems": true
        },
        "generation_pin": {
          "$ref": "#/$defs/generation_pin"
        },
        "policy_pin": {
          "$ref": "#/$defs/policy_pin"
        },
        "content_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "memory_evidence_envelope": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/common_header"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "observation_id",
        "evidence_kind",
        "subject_ref",
        "capture_ref",
        "evidence_refs",
        "freshness",
        "trust",
        "taint"
      ],
      "properties": {
        "contract_type": {
          "const": "memory_evidence_envelope"
        },
        "contract_id": {
          "const": "C01"
        },
        "contract_name": {
          "const": "MemoryEvidenceEnvelope"
        },
        "observation_id": {
          "$ref": "#/$defs/ref"
        },
        "evidence_kind": {
          "enum": [
            "owner_source",
            "runtime_observation",
            "eval_receipt",
            "operator_decision"
          ]
        },
        "subject_ref": {
          "$ref": "#/$defs/ref"
        },
        "capture_ref": {
          "$ref": "#/$defs/ref"
        },
        "evidence_refs": {
          "$ref": "#/$defs/non_empty_ref_list"
        },
        "freshness": {
          "$ref": "#/$defs/freshness_pin"
        },
        "trust": {
          "$ref": "#/$defs/trust_posture"
        },
        "taint": {
          "$ref": "#/$defs/taint_posture"
        }
      }
    },
    "memory_candidate_packet": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/common_header"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "candidate_id",
        "evidence_envelope_ref",
        "target_kind",
        "candidate_payload_ref",
        "derivation_lineage_refs",
        "risk_class",
        "data_class",
        "tenant_id",
        "expires_at",
        "taint",
        "proposed_belief",
        "proposed_applicability",
        "expected_stronger_owner",
        "allowed_result",
        "review_state"
      ],
      "properties": {
        "contract_type": {
          "const": "memory_candidate_packet"
        },
        "contract_id": {
          "const": "C02"
        },
        "contract_name": {
          "const": "MemoryCandidatePacket"
        },
        "candidate_id": {
          "$ref": "#/$defs/ref"
        },
        "evidence_envelope_ref": {
          "$ref": "#/$defs/ref"
        },
        "target_kind": {
          "enum": [
            "anchor",
            "state_capsule",
            "episode",
            "claim",
            "decision",
            "pattern",
            "bridge",
            "audit_event"
          ]
        },
        "candidate_payload_ref": {
          "$ref": "#/$defs/ref"
        },
        "derivation_lineage_refs": {
          "$ref": "#/$defs/non_empty_ref_list"
        },
        "risk_class": {
          "enum": [
            "R0",
            "R1",
            "R2",
            "R3",
            "R4",
            "R5",
            "R6"
          ]
        },
        "data_class": {
          "enum": [
            "D0",
            "D1",
            "D2",
            "D3",
            "D4"
          ]
        },
        "tenant_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "taint": {
          "$ref": "#/$defs/taint_posture"
        },
        "proposed_belief": {
          "$ref": "#/$defs/proposed_belief"
        },
        "proposed_applicability": {
          "$ref": "#/$defs/proposed_applicability"
        },
        "expected_stronger_owner": {
          "$ref": "#/$defs/owner_id"
        },
        "allowed_result": {
          "enum": [
            "operator_review",
            "quarantine",
            "reject"
          ]
        },
        "review_state": {
          "const": "proposed"
        }
      }
    },
    "memory_quarantine_packet": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/common_header"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "quarantine_id",
        "candidate_ref",
        "reason_codes",
        "release_conditions",
        "quarantined_at",
        "expires_at",
        "taint",
        "expected_stronger_owner",
        "allowed_result",
        "semantic_promotion",
        "normal_recall",
        "proactive_delivery",
        "export_use",
        "training_use"
      ],
      "properties": {
        "contract_type": {
          "const": "memory_quarantine_packet"
        },
        "contract_id": {
          "const": "C03"
        },
        "contract_name": {
          "const": "MemoryQuarantinePacket"
        },
        "quarantine_id": {
          "$ref": "#/$defs/ref"
        },
        "candidate_ref": {
          "$ref": "#/$defs/ref"
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        },
        "release_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        },
        "quarantined_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "taint": {
          "$ref": "#/$defs/taint_posture"
        },
        "expected_stronger_owner": {
          "$ref": "#/$defs/owner_id"
        },
        "allowed_result": {
          "enum": [
            "remain_quarantined",
            "operator_review",
            "purge"
          ]
        },
        "semantic_promotion": {
          "const": "forbidden"
        },
        "normal_recall": {
          "const": "forbidden"
        },
        "proactive_delivery": {
          "const": "forbidden"
        },
        "export_use": {
          "const": "forbidden"
        },
        "training_use": {
          "const": "forbidden"
        }
      }
    },
    "reviewed_memory_object": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "memory_object_ref",
        "memory_object_schema_ref",
        "accepted_transition_ref",
        "review_state",
        "access_class",
        "private_corpus_decision_refs"
      ],
      "properties": {
        "contract_type": {
          "const": "reviewed_memory_object"
        },
        "contract_id": {
          "const": "C04"
        },
        "contract_name": {
          "const": "ReviewedMemoryObject"
        },
        "memory_object_ref": {
          "$ref": "#/$defs/ref"
        },
        "memory_object_schema_ref": {
          "$ref": "#/$defs/ref"
        },
        "accepted_transition_ref": {
          "$ref": "#/$defs/ref"
        },
        "review_state": {
          "enum": [
            "confirmed",
            "frozen",
            "superseded",
            "retracted",
            "archived"
          ]
        },
        "access_class": {
          "enum": [
            "public",
            "private"
          ]
        },
        "private_corpus_decision_refs": {
          "$ref": "#/$defs/ref_list"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/common_header"
        },
        {
          "if": {
            "properties": {
              "access_class": {
                "const": "private"
              }
            },
            "required": [
              "access_class"
            ]
          },
          "then": {
            "properties": {
              "private_corpus_decision_refs": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "private_corpus_decision_refs": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "provenance_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "event_ref",
        "event_digest"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "event_ref": {
          "$ref": "#/$defs/ref"
        },
        "event_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "provenance_thread": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/common_header"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "thread_id",
        "subject_refs",
        "evidence_envelope_refs",
        "transition_refs",
        "ordered_events",
        "lineage_digest",
        "content_minimized",
        "deleted_content_retained",
        "embedding_retained",
        "reversible_hash_retained"
      ],
      "properties": {
        "contract_type": {
          "const": "provenance_thread"
        },
        "contract_id": {
          "const": "C05"
        },
        "contract_name": {
          "const": "ProvenanceThread"
        },
        "thread_id": {
          "$ref": "#/$defs/ref"
        },
        "subject_refs": {
          "$ref": "#/$defs/non_empty_ref_list"
        },
        "evidence_envelope_refs": {
          "$ref": "#/$defs/non_empty_ref_list"
        },
        "transition_refs": {
          "$ref": "#/$defs/ref_list"
        },
        "ordered_events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/provenance_event"
          }
        },
        "lineage_digest": {
          "$ref": "#/$defs/sha256"
        },
        "content_minimized": {
          "const": true
        },
        "deleted_content_retained": {
          "const": false
        },
        "embedding_retained": {
          "const": false
        },
        "reversible_hash_retained": {
          "const": false
        }
      }
    },
    "memory_lifecycle_transition": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "transition_id",
        "subject_ref",
        "transition_kind",
        "from_state",
        "to_state",
        "expected_prior_version",
        "next_version",
        "operator_decision_ref",
        "accepted_policy_ref",
        "belief_commit_id",
        "accepted_transition_ref",
        "commit_mode",
        "source_generation",
        "projection_states",
        "projection_invalidation_refs",
        "commit_receipt_ref",
        "audit_event_ref"
      ],
      "properties": {
        "contract_type": {
          "const": "memory_lifecycle_transition"
        },
        "contract_id": {
          "const": "C06"
        },
        "contract_name": {
          "const": "MemoryLifecycleTransition"
        },
        "transition_id": {
          "$ref": "#/$defs/ref"
        },
        "subject_ref": {
          "$ref": "#/$defs/ref"
        },
        "transition_kind": {
          "enum": [
            "mechanical",
            "semantic"
          ]
        },
        "from_state": {
          "enum": [
            "captured",
            "proposed",
            "confirmed",
            "frozen",
            "superseded",
            "retracted",
            "archived"
          ]
        },
        "to_state": {
          "enum": [
            "proposed",
            "confirmed",
            "frozen",
            "superseded",
            "retracted",
            "archived"
          ]
        },
        "expected_prior_version": {
          "type": "integer",
          "minimum": 1
        },
        "next_version": {
          "type": "integer",
          "minimum": 2
        },
        "operator_decision_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 3
        },
        "accepted_policy_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 3
        },
        "belief_commit_id": {
          "$ref": "#/$defs/ref"
        },
        "accepted_transition_ref": {
          "$ref": "#/$defs/ref"
        },
        "commit_mode": {
          "enum": [
            "atomic",
            "recoverable"
          ]
        },
        "source_generation": {
          "type": "integer",
          "minimum": 1
        },
        "projection_states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/projection_state"
          }
        },
        "projection_invalidation_refs": {
          "$ref": "#/$defs/ref_list"
        },
        "commit_receipt_ref": {
          "$ref": "#/$defs/ref"
        },
        "audit_event_ref": {
          "$ref": "#/$defs/ref"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/common_header"
        },
        {
          "if": {
            "properties": {
              "transition_kind": {
                "const": "semantic"
              }
            },
            "required": [
              "transition_kind"
            ]
          },
          "then": {
            "properties": {
              "operator_decision_ref": {
                "type": "string",
                "minLength": 3
              },
              "accepted_policy_ref": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "operator_decision_ref": {
                "type": "null"
              },
              "accepted_policy_ref": {
                "type": "string",
                "minLength": 3
              }
            }
          }
        }
      ]
    },
    "projection_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection_ref",
        "state",
        "source_generation",
        "invalidation_receipt_ref"
      ],
      "properties": {
        "projection_ref": {
          "$ref": "#/$defs/ref"
        },
        "state": {
          "enum": [
            "active",
            "stale",
            "pending_rebuild",
            "invalidated"
          ]
        },
        "source_generation": {
          "type": "integer",
          "minimum": 1
        },
        "invalidation_receipt_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 3
        }
      }
    },
    "object_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_ref",
        "object_version",
        "lifecycle_state",
        "content_digest"
      ],
      "properties": {
        "object_ref": {
          "$ref": "#/$defs/ref"
        },
