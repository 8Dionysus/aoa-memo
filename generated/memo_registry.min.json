    "recall_contract"
  ],
  "recall_modes": [
    "working",
    "episodic",
    "semantic",
    "procedural",
    "lineage",
    "source_route"
  ],
  "temperature_scale": [
    "hot",
    "warm",
    "cool",
    "cold",
    "frozen"
  ],
