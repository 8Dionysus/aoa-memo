{
  "layer": "aoa-memo",
  "version": "0.2.3",
  "status": "contract-hardening",
  "owns": [
    "memory objects",
    "provenance threads",
    "memory temperature posture",
    "salience posture",
    "recall contracts",
    "compact memory surfaces"
  ],
  "memory_object_kinds": [
    "anchor",
    "state_capsule",
    "episode",
    "claim",
    "decision",
    "pattern",
    "bridge",
    "audit_event"
  ],
  "supporting_objects": [
