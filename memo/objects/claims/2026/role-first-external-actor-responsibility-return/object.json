{
  "id": "memo.claim.2026-08-15.role-first-external-actor-responsibility-return",
  "kind": "claim",
  "title": "Role-first external actors preserve responsibility across pause and filtered return",
  "summary": "Reviewed evidence records a reusable external-actor contour that binds one obligation to a role and incarnation, records bounded stop/resume work, returns a review-required result, wakes the parent as transport evidence, and leaves claim filtering, acceptance, rollback, and durable memory promotion to their owners.",
  "scope": [
    "repo:aoa-agents",
    "repo:aoa-memo",
    "workspace:OS-Abyss"
  ],
  "owner_refs": [
    "repo:aoa-agents",
    "repo:aoa-memo"
  ],
  "payload_ref": "memo/intake/reviewed/aoa-agents.20260815T103403Z.role-first-external-actor-work-is-reusable-only.aoa-memo-intake.json",
  "tags": [
    "reviewed-intake",
    "local-memo-port",
    "agent-behavior",
    "external-actors",
    "responsibility-handoff",
    "pause-resume",
    "filtered-return"
  ],
  "memory_class": "bounded-pattern-claim",
  "memory_content": {
    "contour": [
      "obligation -> role mandate -> model realization -> specialized external incarnation",
      "same-session stop/resume with a bounded workspace delta",
      "review-required result -> parent pause/reentry -> wake delivery",
      "master return filtering -> owner acceptance or rollback, with durable memory as a separate gate"
    ],
    "proven_capabilities": [
      "The Luna external Codex session stopped and resumed in the same thread/incarnation and produced a bounded reviewed workspace delta.",
      "The parent controller yielded and reentered with a distinct wake signal; helper transport and Goal/master state were kept separate.",
      "Source landing and repair were completed for abyss-stack PRs #379 and #386 and aoa-agents PRs #280 and #281, with the cited merge and CI refs preserved in provenance.",
      "The aoa-agents receipt producer/repair path validates responsibility receipts and source projections, but it does not by itself publish a canonical live aoa-stats actor event."
    ],
    "rough_edges": [
      "A review-required return is not owner acceptance; the observed master return remained pending filtering.",
      "The fresh owner preparer failed closed when the writer plan did not bind an exact reviewer role.",
      "Wake-helper success is transport evidence only; timer drift/rearm, environment-limited checks, and local stats-port validation remain operational sharp edges.",
      "The actor shell needed GIT_OPTIONAL_LOCKS=0 to avoid private Git-lock drift, and a non-empty workspace must be judged by baseline/final manifests rather than source-manifest equality."
    ],
    "open_directions": [
      "Add fresh evaluator/model-fit and role-scoped MCP evidence, then separately admit a canonical live actor receipt through aoa-stats and its watcher/deployment owner.",
      "Make exact reviewer-role binding a required input for the preparer and record the filtered-return decision as its own owner receipt.",
      "Create two independent reviewed episode objects for this contour before promoting this bounded claim to a stronger recurring pattern.",
      "Recheck active release, rollback, timer, workspace, and live-feed currentness before using this memo to orchestrate a new actor."
    ]
  },
  "claim_boundary": {
    "accepted": [
      "Typed responsibility can survive an external incarnation's pause, wake, and return when each transition is evidenced and filtering remains explicit.",
      "The source, runtime, receipt, statistics, acceptance, and memory lifecycles are separable gates."
    ],
    "not_claimed": [
      "Full parent Goal completion, autonomous agency, model fit, recurring production readiness, or benefit.",
      "Live aoa-stats admission, owner acceptance inferred from wake delivery, host/service lifecycle changes, or a universal external-agent policy."
    ]
  },
  "currentness": {
    "status": "allowed",
    "as_of": "2026-08-15",
