{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/8Dionysus/aoa-memo/main/mechanics/retention/parts/consolidation-and-forgetting/schemas/active_organ_memo_erasure_owner_extension_v0.schema.json",
  "title": "aoa-memo Phase 11 owner erasure extension v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "extension_id",
    "parent_owner",
    "worker_owner",
    "surface_id",
    "work_item_ref",
    "material_classes",
    "target_ref_digests",
    "operation_evidence_refs",
    "recovery_probe_ref",
    "result",
    "residue_refs",
    "retention_exceptions",
    "subject_material_included",
    "content_minimized",
    "execution_posture",
    "live_execution",
    "effect_authority",
    "global_completion_authority",
    "content_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "active_organ_owner_erasure_extension_v0"
    },
    "extension_id": {
      "$ref": "#/$defs/ref"
    },
    "parent_owner": {
      "const": "aoa-memo"
    },
    "worker_owner": {
      "enum": [
        "aoa-memo-er0",
        "aoa-memo-er9"
      ]
    },
    "surface_id": {
      "enum": [
        "ER0",
        "ER9"
      ]
    },
    "work_item_ref": {
      "$ref": "#/$defs/ref"
    },
    "material_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "canonical_object",
          "summary",
          "markdown_read_model",
          "content_minimized_tombstone"
        ]
      }
    },
    "target_ref_digests": {
      "$ref": "#/$defs/digests"
    },
    "operation_evidence_refs": {
      "$ref": "#/$defs/refs"
    },
    "recovery_probe_ref": {
      "$ref": "#/$defs/ref"
    },
    "result": {
      "enum": [
        "erased",
        "residue",
        "partial",
        "failed"
      ]
    },
    "residue_refs": {
      "$ref": "#/$defs/refs_optional"
    },
    "retention_exceptions": {
      "type": "array"
    },
    "subject_material_included": {
      "const": false
    },
    "content_minimized": {
      "const": true
    },
    "execution_posture": {
      "const": "reference_lab_only"
    },
    "live_execution": {
      "const": false
    },
    "effect_authority": {
      "const": "owner_local_erasure_only"
    },
    "global_completion_authority": {
      "const": false
    },
    "content_digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "surface_id": {
            "const": "ER0"
          }
        },
        "required": [
          "surface_id"
        ]
      },
      "then": {
        "properties": {
          "worker_owner": {
            "const": "aoa-memo-er0"
          },
          "material_classes": {
            "minItems": 3,
            "maxItems": 3,
            "allOf": [
              {
                "contains": {
                  "const": "canonical_object"
                }
              },
              {
                "contains": {
                  "const": "summary"
                }
              },
              {
                "contains": {
                  "const": "markdown_read_model"
                }
              }
            ]
          }
        }
      },
      "else": {
        "properties": {
          "worker_owner": {
            "const": "aoa-memo-er9"
          },
          "material_classes": {
            "const": [
              "content_minimized_tombstone"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "digests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "refs_optional": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ref"
      }
    }
  }
}
