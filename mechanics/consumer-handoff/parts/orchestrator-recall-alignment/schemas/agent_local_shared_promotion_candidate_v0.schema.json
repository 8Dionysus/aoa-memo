{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/8Dionysus/aoa-memo/main/mechanics/consumer-handoff/parts/orchestrator-recall-alignment/schemas/agent_local_shared_promotion_candidate_v0.schema.json",
  "title": "Agent-Local Shared Promotion Candidate v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "source_namespace",
    "source_case",
    "target",
    "evidence_refs",
    "outcome_refs",
    "duplicate_check_refs",
    "conflict_check_refs",
    "review_posture",
    "authority"
  ],
  "properties": {
    "schema_version": {
      "const": "agent_local_shared_promotion_candidate_v0"
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^promotion-candidate:[a-z0-9][a-z0-9._-]+$"
    },
    "source_namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace_id",
        "namespace_generation",
        "agent_id",
        "tenant_id",
        "owner",
        "contract_ref",
        "contract_digest"
      ],
      "properties": {
        "namespace_id": {
          "type": "string",
          "pattern": "^namespace:[a-z0-9][a-z0-9._-]+$"
        },
        "namespace_generation": {
          "type": "integer",
          "minimum": 1
        },
        "agent_id": {
          "type": "string",
          "minLength": 3
        },
        "tenant_id": {
          "type": "string",
          "pattern": "^tenant:[a-z0-9][a-z0-9._-]+$"
        },
        "owner": {
          "const": "aoa-agents"
        },
        "contract_ref": {
          "const": "schemas/active-organ-agent-local-namespace-v0.schema.json"
        },
        "contract_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "source_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_ref",
        "case_digest",
        "case_class",
        "data_class",
        "raw_payload_included"
      ],
      "properties": {
        "case_ref": {
          "type": "string",
          "minLength": 3
        },
        "case_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "case_class": {
          "enum": [
            "episodic",
            "procedural"
          ]
        },
        "data_class": {
          "enum": [
            "D0",
            "D1",
            "D2",
            "D3"
          ]
        },
        "raw_payload_included": {
          "const": false
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "tenant_id",
        "candidate_kind",
        "shared_scope"
      ],
      "properties": {
        "owner": {
          "const": "aoa-memo"
        },
        "tenant_id": {
          "type": "string",
          "pattern": "^tenant:[a-z0-9][a-z0-9._-]+$"
        },
        "candidate_kind": {
          "enum": [
            "episode",
            "pattern"
          ]
        },
        "shared_scope": {
          "enum": [
            "repo",
            "project",
            "workspace",
            "ecosystem"
          ]
        }
      }
    },
    "evidence_refs": {
      "$ref": "#/$defs/ref_list"
    },
    "outcome_refs": {
      "$ref": "#/$defs/ref_list"
    },
    "duplicate_check_refs": {
      "$ref": "#/$defs/ref_list"
    },
    "conflict_check_refs": {
      "$ref": "#/$defs/ref_list"
    },
    "review_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "operator_review_required",
        "allowed_result",
        "direct_shared_write"
      ],
      "properties": {
        "state": {
          "const": "proposed"
        },
        "operator_review_required": {
          "const": true
        },
        "allowed_result": {
          "const": "promotion_admission_receipt"
        },
        "direct_shared_write": {
          "const": "forbidden"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shared_truth",
        "semantic_transition",
        "policy_change",
        "role_or_permission_change",
        "external_effects",
        "training_use"
      ],
      "properties": {
        "shared_truth": {
          "const": "forbidden"
        },
        "semantic_transition": {
          "const": "forbidden"
        },
        "policy_change": {
          "const": "forbidden"
        },
        "role_or_permission_change": {
          "const": "forbidden"
        },
        "external_effects": {
          "const": "forbidden"
        },
        "training_use": {
          "const": "forbidden"
        }
      }
    }
  },
  "$defs": {
    "ref_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    }
  }
}
