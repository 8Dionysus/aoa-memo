{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents-of-abyss.dev/schemas/aoa-memo/aoa_memo_participation_hook_fragment_v0.schema.json",
  "title": "AoA memo Codex participation hook fragment v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fragment_id",
    "owner",
    "mode",
    "description",
    "bindings",
    "hooks"
  ],
  "properties": {
    "schema_version": {
      "const": "abyss_codex_hooks_fragment_v0"
    },
    "fragment_id": {
      "const": "aoa-memo:participation-shadow:v0"
    },
    "owner": {
      "const": "aoa-memo"
    },
    "mode": {
      "const": "shadow"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "bindings": {
      "type": "array",
      "prefixItems": [
        {
          "const": "AOA_MEMO_HOOK_SCRIPT"
        },
        {
          "const": "AOA_MEMO_STATE_ROOT"
        }
      ],
      "items": false
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "SessionStart",
        "UserPromptSubmit",
        "PostToolUse",
        "PreCompact",
        "PostCompact",
        "Stop",
        "SessionEnd"
      ],
      "properties": {
        "SessionStart": {
          "$ref": "#/$defs/unmatchedGroups"
        },
        "UserPromptSubmit": {
          "$ref": "#/$defs/unmatchedGroups"
        },
        "PostToolUse": {
          "$ref": "#/$defs/memoToolGroups"
        },
        "PreCompact": {
          "$ref": "#/$defs/unmatchedGroups"
        },
        "PostCompact": {
          "$ref": "#/$defs/unmatchedGroups"
        },
        "Stop": {
          "$ref": "#/$defs/unmatchedGroups"
        },
        "SessionEnd": {
          "$ref": "#/$defs/unmatchedGroups"
        }
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "command",
        "timeout"
      ],
      "properties": {
        "type": {
          "const": "command"
        },
        "command": {
          "const": "/usr/bin/python3 \"{{AOA_MEMO_HOOK_SCRIPT}}\" observe --state-root \"{{AOA_MEMO_STATE_ROOT}}\""
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        }
      }
    },
    "unmatchedGroups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hooks"
          ],
          "properties": {
            "hooks": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "prefixItems": [
                {
                  "$ref": "#/$defs/command"
                }
              ],
              "items": false
            }
          }
        }
      ],
      "items": false
    },
    "memoToolGroups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "matcher",
            "hooks"
          ],
          "properties": {
            "matcher": {
              "const": "^mcp__aoa_memo__.*$"
            },
            "hooks": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "prefixItems": [
                {
                  "$ref": "#/$defs/command"
                }
              ],
              "items": false
            }
          }
        }
      ],
      "items": false
    }
  }
}
