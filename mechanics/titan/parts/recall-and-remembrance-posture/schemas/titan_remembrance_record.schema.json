{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aoa.local/mechanics/titan/parts/recall-and-remembrance-posture/schemas/titan_remembrance_record.schema.json",
  "title": "Titan Remembrance Record",
  "description": "Titan remembrance records preserve memory candidates with explicit provenance. Memory remains a route to source, not proof.",
  "type": "object",
  "required": [
    "record_id",
    "bearer_id",
    "titan_name",
    "claim",
    "authority"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "bearer_id": {
      "type": "string",
      "pattern": "^titan:"
    },
    "titan_name": {
      "type": "string",
      "enum": [
        "Atlas",
        "Sentinel",
        "Mneme",
        "Forge",
        "Delta"
      ]
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "string",
      "enum": [
        "candidate",
        "route_to_source"
      ]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "lineage_event_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "anyOf": [
    {
      "required": [
        "source_refs"
      ]
    },
    {
      "required": [
        "receipt_id"
      ]
    },
    {
      "required": [
        "session_id"
      ]
    },
    {
      "required": [
        "lineage_event_ref"
      ]
    }
  ],
  "additionalProperties": false
}
